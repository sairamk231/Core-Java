class Employee {
   private  int age;
   public int getAge() {
        return age;
    }

    public void setAge(int age) {
        if (age > 0 && age < 60) {
            this.age = age;
        } else {
            throw new IllegalArgumentException("Invalid age");
        }
    }
}
public class Main {
    public static void main(String[] args) {
        Employee emp = new Employee();
        emp.setAge(30);
        System.out.println(emp.getAge());
    }
}

OUTPUT:- 30






